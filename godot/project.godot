; Engine configuration for Godot 4.x — thin physical veneer (ADR 0001 / 0004).
config_version=5

[application]

config/name="sep_26_concrete"
config/description="CONCRETE lab UI — backend is ground truth"
run/main_scene="res://scenes/world.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://images/concrete_icon_200.png"

[autoload]

_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="forward_plus"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")
